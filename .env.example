## Application
APP_NAME=English Learning Server
APP_ENV=development
APP_DEBUG=true

## Database
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/english_learning
APP_DATABASE_ECHO=false
APP_AUTO_CREATE_TABLES=false

## Security / JWT
APP_SECRET_KEY=your-app-secret-key
APP_JWT_ALGORITHM=HS256
APP_ACCESS_TOKEN_EXPIRE_MINUTES=60

## Authentik / OIDC
APP_AUTHENTIK_ENABLED=false
APP_AUTHENTIK_ISSUER_URL=https://auth.example.com/application/o/english-learning
APP_AUTHENTIK_CLIENT_ID=your-authentik-client-id
APP_AUTHENTIK_CLIENT_SECRET=your-authentik-client-secret
APP_AUTHENTIK_SCOPES=openid email profile
APP_AUTHENTIK_ALLOWED_REDIRECT_URIS=http://localhost:5173/auth/callback
APP_OAUTH_LOGIN_CODE_EXPIRE_SECONDS=120
APP_SESSION_COOKIE_NAME=english_learning_session
APP_SESSION_COOKIE_SECURE=false

## CORS
APP_CORS_ALLOW_CREDENTIALS=true
APP_CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
APP_CORS_ALLOW_HEADERS=Content-Type,Authorization
APP_CORS_EXPOSE_HEADERS=
APP_CORS_MAX_AGE=600
APP_CORS_DEV_ALLOW_ORIGINS=http://localhost:5173
APP_CORS_PROD_ALLOW_ORIGINS=https://your-frontend-domain.com

## Dictionary Provider
APP_DICTIONARY_API_BASE_URL=https://api.dictionaryapi.dev/api/v2/entries/en

## Youdao
YOUDAO_APP_KEY=your-youdao-app-key
YOUDAO_APP_SECRET=your-youdao-app-secret
YOUDAO_API_BASE_URL=https://openapi.youdao.com/api
